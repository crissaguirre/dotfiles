* {
    font:           "Figtree 13";
    g-spacing:      10px;
    g-margin:       0;
    b-radius:       10px;
    g-padding:      8px;
    w-padding:      14px;

    bg:             #0a0a14FF;
    bg-alt:         #111118FF;
    bg-input:       rgba(255,255,255,0.05);
    border-col:     rgba(255,255,255,0.10);
    fg:             rgba(255,255,255,0.85);
    fg-dim:         rgba(255,255,255,0.30);
    hl-bg:          #FFFFFFFF;
    hl-fg:          #0a0a14FF;
    wbg:            rgba(10,10,20,0.92);
}

configuration {
    modi:           "drun";
    show-icons:     true;
    display-drun:   "";
    drun-display-format: "{name}";
    icon-theme:     "Papirus-Dark";
}

window {
    transparency:       "real";
    width:              500px;
    border-radius:      @b-radius;
    background-color:   @wbg;
    border:             1px solid;
    border-color:       @border-col;
    padding:            @w-padding;
}

mainbox {
    spacing:    10px;
    padding:    0;
    children:   ["inputbar", "listview"];
}

inputbar {
    children:           ["prompt", "entry"];
    spacing:            8px;
    padding:            10px 12px;
    background-color:   @bg-input;
    border-radius:      8px;
    border:             1px solid;
    border-color:       @border-col;
}

prompt {
    text-color:     @fg-dim;
    font:           "Figtree 13";
}

entry {
    placeholder:        "Search apps";
    text-color:         @fg;
    placeholder-color:  @fg-dim;
}

listview {
    columns:        1;
    lines:          8;
    fixed-height:   true;
    cycle:          false;
    scrollbar:      false;
    spacing:        6px;
    border:         0px;
}

element active.normal {
    background-color: rgba(255,255,255,0.08);
    text-color:       @fg;
}

element normal.urgent {
    background-color: rgba(255, 100, 100, 0.15);
}


element {
    padding:            9px 12px;
    spacing:            12px;
    border-radius:      8px;
    background-color:   transparent;
    text-color:         @fg;
    border:             0px;
}

element-icon {
    size:           28px;
    border-radius:  6px;
}

element-text {
    vertical-align: 0.5;
}

element normal.normal {
    background-color: transparent;
    text-color:       @fg;
}

element alternate.normal {
    background-color: @bg-alt;
    text-color:       @fg;
}

element selected.normal,
element selected.active {
    background-color: @hl-bg;
    text-color:       @hl-fg;
}

message {
    border:             0px;
    background-color:   transparent;
}
